{
    "name": "universetech-inc/watchdog",
    "type": "library",
    "description": "The watchdog package for Hypervel.",
    "license": "MIT",
    "keywords": [
        "php",
        "watchdog",
        "hypervel"
    ],
    "autoload": {
        "psr-4": {
            "UniverseTech\\Watchdog\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-swoole": "^6.2",
        "hypervel/console": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/coroutine": "^0.4",
        "hypervel/engine": "^0.4",
        "hypervel/filesystem": "^0.4",
        "hypervel/foundation": "^0.4",
        "hypervel/process": "^0.4",
        "hypervel/support": "^0.4",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1",
        "vlucas/phpdotenv": "^5.6.1"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-0.4": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "UniverseTech\\Watchdog\\WatchdogServiceProvider"
            ]
        }
    }
}
