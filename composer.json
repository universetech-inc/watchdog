{
    "name": "universetech-inc/watchdog",
    "type": "library",
    "description": "The watchdog package for Hypervel.",
    "license": "MIT",
    "keywords": [
        "php",
        "watchdog",
        "hypervel"
    ],
    "autoload": {
        "psr-4": {
            "UniverseTech\\Watchdog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UniverseTech\\Watchdog\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-swoole": "^6.2",
        "hypervel/console": "^0.4",
        "hypervel/contracts": "^0.4",
        "hypervel/coroutine": "^0.4",
        "hypervel/engine": "^0.4",
        "hypervel/filesystem": "^0.4",
        "hypervel/foundation": "^0.4",
        "hypervel/process": "^0.4",
        "hypervel/server": "^0.4",
        "hypervel/support": "^0.4",
        "psr/log": "^3.0",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1",
        "vlucas/phpdotenv": "^5.6.1"
    },
    "require-dev": {
        "brianium/paratest": "^7.24",
        "fakerphp/faker": "^1.24",
        "hypervel/components": "0.4.x-dev",
        "mockery/mockery": "^1.6.15",
        "phpunit/phpunit": "^13.0.3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --exclude-group integration",
        "test:integration": "phpunit --group integration"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-0.4": "0.4-dev"
        },
        "hypervel": {
            "providers": [
                "UniverseTech\\Watchdog\\WatchdogServiceProvider"
            ]
        }
    }
}
